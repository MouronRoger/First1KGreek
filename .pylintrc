[MASTER]
# Compatibility with Black and flake8
disable=
    C0103, # invalid-name
    C0111, # missing-docstring (handled by pydocstyle)
    W0311, # bad-indentation (conflicts with black)
    E1101, # no-member (can be noisy)
    R0903, # too-few-public-methods
    R0913, # too-many-arguments

# Max line length (matching Black)
max-line-length=88

[FORMAT]
# Black-compatible settings
expected-line-ending-format=LF

[MESSAGES CONTROL]
# Only enable errors and warnings
enable=E,W

[REPORTS]
# Output format
output-format=text
reports=yes
evaluation=10.0 - ((float(5 * error + warning + refactor + convention) / statement) * 10)

[BASIC]
# Good variable names
good-names=i,j,k,ex,Run,_,id,df

[SIMILARITIES]
# Ignore comments when computing similarities
ignore-comments=yes
ignore-docstrings=yes
ignore-imports=yes
min-similarity-lines=6 