root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.py]
indent_style = space
indent_size = 4
max_line_length = 88  # Black's default line length

[*.xml]
# Preserve XML formatting
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
